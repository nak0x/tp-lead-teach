# Copy this file to ".env" and fill in the values. ".env" is git-ignored.

# Absolute path to the Google service account JSON key file.
# Put the key SOMEWHERE ON YOUR FILE SYSTEM but NOT inside this repository.
# On render.com, upload it as a secret file and set this variable in the UI.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ALTERNATIVE for platforms that can only inject env vars, not files (e.g.
# Coolify): leave GOOGLE_APPLICATION_CREDENTIALS unset and instead paste the
# JSON key's *contents* here. The Docker entrypoint writes it to
# /app/service-account.json and points GOOGLE_APPLICATION_CREDENTIALS at it.
# Accepts raw JSON (starts with "{") or base64-encoded JSON.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Google Cloud project that hosts the Pub/Sub topic and the bucket.
GOOGLE_CLOUD_PROJECT=ecni2-2026

# The number "i" you were attributed. The Pub/Sub topic and subscription are
# both named "ecni2-<i>". Example: if i=7 -> topic/subscription "ecni2-7".
PUBSUB_INDEX=

# Google Cloud Storage bucket that stores the generated zips.
STORAGE_BUCKET=ecni22026bucket

# Optional overrides (default to "ecni2-<PUBSUB_INDEX>"):
# PUBSUB_TOPIC=
# PUBSUB_SUBSCRIPTION=

# Set to "false" to run the API without starting the background worker.
# WORKER_ENABLED=true

# Optional HTTP port (defaults to 3000).
# PORT=3000

# --- Firebase (Realtime Database + Auth) -------------------------------------
# The Firebase Admin SDK authenticates with the SAME service account key as
# Pub/Sub / Storage (GOOGLE_APPLICATION_CREDENTIALS) - no extra credentials.

# Realtime Database URL. Defaults to the TP database.
# FIREBASE_DATABASE_URL=https://ecni2-2026-default-rtdb.firebaseio.com

# Root path segment ("votreprenom") for stored zips:
#   /<FIREBASE_DB_ROOT>/<heureduzippage>/<filename>
FIREBASE_DB_ROOT=theo

# Turn the whole Firebase integration on/off (defaults on outside tests).
# FIREBASE_ENABLED=true

# Require a verified Firebase ID token (Google Sign-In) on POST /zip.
# Defaults on wherever Firebase is enabled.
# AUTH_REQUIRED=true

# --- Rate limiting (token bucket) --------------------------------------------
# Per-IP throttling of the zip generation endpoint. Constants (defaults shown):
#   RATE_LIMIT_REFILL_PER_SECOND=1   # r    - tokens gained per second
#   RATE_LIMIT_BUCKET_SIZE=15        # b    - bucket size / starting burst
#   RATE_LIMIT_REQUEST_COST=3        # cost - tokens spent per request
# Turn the whole limiter off with RATE_LIMIT_ENABLED=false.

# Redis (in-memory DB) shared by all instances so the limit is global, not
# per-instance (Part III). Provide EITHER a full URL:
# REDIS_URL=redis://default:password@host:6379
# OR the individual pieces (the TP gives you a Redis Cloud instance):
# REDIS_USERNAME=default
# REDIS_PASSWORD=              # NEVER commit the real password (keep it in .env)
# REDIS_HOST=redis-19512.c16.us-east-1-2.ec2.cloud.redislabs.com
# REDIS_PORT=19512
# Without any REDIS_* value the limiter uses a per-process in-memory map (Part II).
