{
  "extends": "eslint:recommended",
  "env": {
    "node": true,
    "es2021": true,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "globals": {
    "jest": false,
    "expect": false,
    "describe": false,
    "test": false,
    "beforeAll": false,
    "beforeEach": false,
    "afterAll": false,
    "afterEach": false
  },
  "rules": {
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["app/public/**/*.js"],
      "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module"
      },
      "env": {
        "browser": true,
        "node": false,
        "commonjs": false
      }
    }
  ]
}
